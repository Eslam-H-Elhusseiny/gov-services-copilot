APP_NAME="Gov Services Copilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gov_services_copilot
DB_USERNAME=app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=root-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=government_chunks

AI_DEFAULT_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=

GROQ_COMPLETION_MODEL=openai/gpt-oss-120b
GEMINI_COMPLETION_MODEL=gemini-2.5-flash
GROQ_BASE_URI=https://api.groq.com/openai/v1
GEMINI_BASE_URI=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

AI_PRICING_CONFIG_VERSION=
AI_PRICING_EFFECTIVE_DATE=

DEFAULT_USER_TOKEN_BUDGET=250000
TOKEN_BUDGET_PERIOD=monthly
WORKFLOW_MAX_ITERATIONS=6
WORKFLOW_STEP_TIMEOUT=60
WORKFLOW_MAX_RETRIES=2
